# Copy to .env on the host that runs the app. Never commit real values.
PORT=8787
SHOPIFY_API_SECRET=replace-with-app-client-secret
ALLOWED_SHOPS=i13ur2-10.myshopify.com,koko077.com
FASHN_API_KEY=replace-with-server-side-key
FASHN_MODEL=tryon-v1.6
FASHN_MODE=performance
MAX_REQUESTS_PER_MINUTE=8
MAX_BODY_BYTES=9000000
# Per FASHN run. Outfit sets run two sequential steps, so the worst case is about 2x this (170s at the default).
REQUEST_TIMEOUT_MS=85000
